# OS / editor
.DS_Store
*.tmp
*.swp

# Python
__pycache__/
*.pyc

# Local DB + migration backups (personal data)
/jobcopilot.db
/jobs/.backup/

# ---------------------------------------------------------------------------
# LOCAL (personal data — never shared). Each user creates their own.
# The matching *.example.md files are shipped as templates.
# ---------------------------------------------------------------------------
/profile.md

# jobs/, cv/, offers/, prep/ keep only the _example.md and .gitkeep (tracked); ignore the rest.
/jobs/*
!/jobs/_example.md
!/jobs/.gitkeep

/cv/*
!/cv/_example-en.md
!/cv/.gitkeep

/offers/*
!/offers/_example.md
!/offers/.gitkeep

/prep/*
!/prep/_example.md
!/prep/.gitkeep
